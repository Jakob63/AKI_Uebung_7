# ------------------------------------------------------------------
# Kopiere diese Datei und nenne die Kopie ".env" (ohne .example).
# Dann trage unten deinen Schlüssel ein. Die .env NIE weitergeben
# oder hochladen – da steht dein geheimer Schlüssel drin!
# ------------------------------------------------------------------

# Welcher Anbieter? nvidia (Standard, kostenlos), groq oder custom
AI_PROVIDER=nvidia

# --- NVIDIA (kostenlos mit Account) ---
# Schlüssel erstellen: https://build.nvidia.com -> anmelden -> "Get API Key"
# Der Schlüssel fängt mit nvapi- an.
NVIDIA_API_KEY=hier_deinen_key_einfuegen

# --- Groq (kostenlos mit Account, AI_PROVIDER=groq) ---
# Schlüssel erstellen: https://console.groq.com/keys
# GROQ_API_KEY=hier_deinen_key_einfuegen

# --- Eigener Anbieter (AI_PROVIDER=custom), z. B. Ollama auf dem eigenen Rechner ---
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=ollama

# Optional: anderes Modell als das Standard-Modell des Anbieters
# (verfügbare NVIDIA-Modelle: https://build.nvidia.com/models)
# AI_MODEL=mistralai/mistral-large-4-1t-a52b
