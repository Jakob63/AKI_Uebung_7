# ------------------------------------------------------------------
# Kopiere diese Datei und nenne die Kopie ".env" (ohne .example).
# Dann trage unten deinen Schlüssel ein. Die .env NIE weitergeben
# oder hochladen – da steht dein geheimer Schlüssel drin!
# ------------------------------------------------------------------

# Welcher Anbieter? github (Standard, kostenlos), nvidia oder custom
AI_PROVIDER=github

# --- GitHub Models (kostenlos mit GitHub-Account) ---
# Token erstellen: https://github.com/settings/personal-access-tokens/new
#   -> "Fine-grained token", bei "Permissions" -> "Models" auf "Read-only" stellen
GITHUB_TOKEN=hier_deinen_token_einfuegen

# --- NVIDIA (kostenlos mit Account auf https://build.nvidia.com) ---
# NVIDIA_API_KEY=hier_deinen_key_einfuegen

# --- Eigener Anbieter (AI_PROVIDER=custom), z. B. Ollama auf dem eigenen Rechner ---
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=ollama

# Optional: anderes Modell als das Standard-Modell des Anbieters
# AI_MODEL=openai/gpt-4.1
